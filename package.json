{
  "name": "tahseeb-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/og-hosts.mjs",
    "preview": "vite preview",
    "deploy": "node deploy.mjs",
    "test": "node --test \"tests/**/*.test.js\"",
    "dev:prototype": "vite --config vite.prototype.config.js",
    "build:prototype": "vite build --config vite.prototype.config.js",
    "test:prototype": "node --test tests/prototype-model.test.js tests/prototype-round2.test.js tests/prototype-isolation.test.js",
    "localtest:start": "npx -y supabase@2 start -x imgproxy,postgres-meta,supavisor,mailpit,vector,logflare,realtime,studio,edge-runtime",
    "localtest:reset": "node local-test/build-mirror.mjs && npx -y supabase@2 db reset && node local-test/setup.mjs",
    "localtest:stop": "npx -y supabase@2 stop",
    "dev:localtest": "vite --config vite.localtest.config.js --mode localtest",
    "demo:prepare": "npm run localtest:reset && node local-test/demo-prepare.mjs",
    "demo:record": "node local-test/demo-record.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@supabase/supabase-js": "^2.45.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.48.0",
    "pdf-lib": "^1.17.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.11",
    "vite": "^5.4.3"
  }
}
