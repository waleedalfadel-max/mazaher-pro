{
  "version": 2,
  "buildCommand": "npm run build:tatmira-preview",
  "outputDirectory": "dist-tatmira-preview",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Tatmira-Build",
          "value": "integrated-v1-20260919"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/accounts",
      "destination": "/index.html"
    },
    {
      "source": "/accounts/(.*)",
      "destination": "/index.html"
    }
  ]
}
