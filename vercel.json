{
  "version": 2,
  "buildCommand": "npm run build:tatmira-preview",
  "outputDirectory": "dist-tatmira-preview",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Tatmira-Build",
          "value": "finance-v1-20260919"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/accounts",
      "destination": "/accounts/index.html"
    }
  ]
}
